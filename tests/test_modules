def test_build_weekly_errors_calculates_error():
    backtest = pd.DataFrame({
        "id_tienda": ["S1", "S1"],
        "id_producto": ["P1", "P1"],
        "fold": [1, 1],
        "fecha": pd.to_datetime(["2024-01-01", "2024-01-02"]),
        "y": [10, 12],
        "pred": [8, 10],
        "modelo": ["ETS_Aditivo_7", "ETS_Aditivo_7"],
    })

    result = build_weekly_errors(backtest)

    assert len(result) == 1
    assert result["demanda_real"].iloc[0] == 22
    assert result["demanda_predicha"].iloc[0] == 18
    assert result["error"].iloc[0] == 4


