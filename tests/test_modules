def test_inventory_policy_generates_q85_q90_q95(
    weekly_forecast, inventory, products
):
    scenarios = np.linspace(50, 100, 100)
    cache = {("S1", "P1"): scenarios}

    recommendations, comparison, summary = recommend_inventory(
        weekly_forecast,
        inventory,
        products,
        cache,
    )

    assert set(comparison["politica"]) == {"Q85", "Q90", "Q95"}
    assert len(recommendations) == 1
    assert len(summary) == 3


def test_inventory_policy_never_recommends_negative_order(
    weekly_forecast, products
):
    enough_inventory = pd.DataFrame({
        "id_tienda": ["S1"],
        "id_producto": ["P1"],
        "stock_actual": [500],
    })

    cache = {
        ("S1", "P1"): np.repeat(70.0, 100)
    }

    recommendations, _, _ = recommend_inventory(
        weekly_forecast,
        enough_inventory,
        products,
        cache,
    )

    assert recommendations["pedido_sugerido"].iloc[0] == 0


def test_inventory_policy_applies_coverage_cap(
    weekly_forecast, inventory, products
):
    cache = {
        ("S1", "P1"): np.repeat(200.0, 100)
    }

    recommendations, _, _ = recommend_inventory(
        weekly_forecast,
        inventory,
        products,
        cache,
    )

    row = recommendations.iloc[0]

    assert row["tope_cobertura"] == 80
    assert row["inventario_objetivo"] == 80
    assert row["pedido_sugerido"] == 60


