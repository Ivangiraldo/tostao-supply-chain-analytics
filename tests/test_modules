def test_validate_inputs_accepts_valid_data(valid_data):
    result = validate_inputs(valid_data)

    assert len(result["sales"]) == 2
    assert result["sales"]["fecha"].notna().all()
    assert result["inventory"]["stock_actual"].iloc[0] == 20


def test_validate_inputs_aggregates_duplicate_daily_sales(valid_data):
    valid_data["sales"] = pd.concat([
        valid_data["sales"],
        valid_data["sales"].iloc[[0]],
    ], ignore_index=True)

    result = validate_inputs(valid_data)

    sales_day = result["sales"].query(
        "fecha == '2024-01-01'"
    )

    assert len(sales_day) == 1
    assert sales_day["unidades_vendidas"].iloc[0] == 20


