def test_forecast_rejects_short_series():
    with pytest.raises(ValueError, match="28 días"):
        forecast_one_series([1, 2, 3], steps=7)


def test_forecast_returns_nonnegative_values():
    values = np.tile([2, 3, 4, 5, 6, 7, 8], 8)

    prediction, model = forecast_one_series(values, steps=7)

    assert len(prediction) == 7
    assert np.isfinite(prediction).all()
    assert (prediction >= 0).all()
    assert model in {
        "ETS_Aditivo_7",
        "Seasonal_Naive_7_fallback",
    }


def test_forecast_uses_fallback_when_ets_fails(monkeypatch):
    class BrokenETS:
        def __init__(self, *args, **kwargs):
            raise ValueError("Error controlado de prueba")

    monkeypatch.setattr(
        forecasting,
        "ExponentialSmoothing",
        BrokenETS,
    )

    values = np.tile([1, 2, 3, 4, 5, 6, 7], 5)

    prediction, model = forecast_one_series(values, steps=7)

    assert model == "Seasonal_Naive_7_fallback"
    np.testing.assert_array_equal(
        prediction,
        np.array([1, 2, 3, 4, 5, 6, 7], dtype=float),
    )


def test_forecast_all_creates_daily_and_weekly_outputs(monkeypatch):
    dates = pd.date_range("2024-01-01", periods=28, freq="D")

    panel = pd.DataFrame({
        "fecha": list(dates),
        "id_tienda": ["S1"] * 28,
        "id_producto": ["P1"] * 28,
        "y": [5.0] * 28,
    })

    monkeypatch.setattr(
        forecasting,
        "forecast_one_series",
        lambda values, steps: (
            np.repeat(5.0, steps),
            "ETS_Aditivo_7",
        ),
    )

    daily, weekly = forecast_all(panel, horizon_days=7)

    assert len(daily) == 7
    assert len(weekly) == 1
    assert weekly["demanda_pronosticada_7d"].iloc[0] == 35.0


