def test_simulate_demand_is_reproducible():
    residuals = np.array([-0.2, 0.0, 0.2])

    first = simulate_demand(100, residuals, 500, seed=42)
    second = simulate_demand(100, residuals, 500, seed=42)

    np.testing.assert_array_equal(first, second)
    assert len(first) == 500
    assert (first >= 0).all()


def test_simulate_demand_rejects_empty_residuals():
    with pytest.raises(ValueError, match="residuos suficientes"):
        simulate_demand(100, [], 100)


def test_create_scenarios_uses_global_pool_when_product_pool_is_small():
    weekly = pd.DataFrame({
        "id_tienda": ["S1"],
        "id_producto": ["P1"],
        "demanda_pronosticada_7d": [100.0],
    })

    errors = pd.DataFrame({
        "id_tienda": ["S1"] * 10,
        "id_producto": ["P2"] * 10,
        "error_relativo": np.linspace(-0.2, 0.2, 10),
    })

    distribution, cache = create_demand_scenarios(
        weekly,
        errors,
        n_simulations=100,
        min_product_errors=30,
        seed=42,
    )

    assert distribution["fuente_residuos"].iloc[0] == "global"
    assert len(cache[("S1", "P1")]) == 100
    assert (cache[("S1", "P1")] >= 0).all()


def test_create_scenarios_rejects_insufficient_global_errors():
    weekly = pd.DataFrame({
        "id_tienda": ["S1"],
        "id_producto": ["P1"],
        "demanda_pronosticada_7d": [100.0],
    })

    errors = pd.DataFrame({
        "id_producto": ["P1"] * 5,
        "error_relativo": [0.1] * 5,
    })

    with pytest.raises(ValueError, match="al menos 10 errores"):
        create_demand_scenarios(weekly, errors)


